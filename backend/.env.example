# =====================================================================
# NEUROSUM AI — RESEARCH ENGINE CONFIGURATION
# =====================================================================

# GROQ API KEY (Get a free API key at: https://console.groq.com/keys)
# Paste your Groq API key below:
GROQ_API_KEY=

# GROQ MODEL CONFIGURATION
# Primary research model requested: openai/gpt-oss-120b
# Alternative models: openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2

# MODULE 1: EXTRACTIVE SUMMARIZATION CONFIG
DISTILBERT_MODEL=distilbert-base-uncased
CHECKPOINTS_DIR=backend/checkpoints

# MODULE 2: REDUNDANCY FILTER CONFIG
# sentence-transformers embedding model for semantic similarity & redundancy pruning
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
DEFAULT_REDUNDANCY_THRESHOLD=0.72

# MODULE 3: FACTUAL VERIFICATION NLI CONFIG
# Cross-encoder model for claim-evidence entailment / contradiction classification
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# ENVIRONMENT
ENVIRONMENT=development
LOG_LEVEL=INFO
